rules_version = '2';

// Todos os dados do Mandatório são públicos e só a sincronização (conta de serviço,
// que ignora estas regras) grava. Ninguém escreve pelo navegador.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
